.{
    .name = .tally_addon,
    .version = "1.0.0",
    .fingerprint = 0xb5c5712f4a8c65ea,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        // Written and kept up to date by `c-cpp-zig-build`.
        .c_cpp_zig_build = .{ .path = ".zig-native" },
        // A path dependency rather than a URL: the point of this example is
        // what the package's build script does, and fetching it over the
        // network would only make that slower to demonstrate.
        .tallies = .{ .path = "vendor/tallies" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "napi", "vendor" },
}
