{
  "name": "digest-example",
  "version": "1.0.0",
  "private": true,
  "description": "One core C library behind a Node addon, a static library and a CLI",
  "main": "./index.cjs",
  "scripts": {
    "build": "node ../../lib/cli.js build",
    "build:debug": "node ../../lib/cli.js build --debug",
    "clean": "node ../../lib/cli.js clean",
    "info": "node ../../lib/cli.js info",
    "digest": "node ../../lib/cli.js build --step run --",
    "test": "node --test"
  }
}
